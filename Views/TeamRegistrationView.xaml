<UserControl x:Class="TournamentManager.Views.TeamRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Tombol aksi ikon di DataGrid -->
        <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Chip status pendaftaran -->
        <DataTemplate x:Key="StatusChipTemplate">
            <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                <Setter Property="Background" Value="#D1FAE5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Menunggu" />
                            <Setter Property="Foreground" Value="#B45309" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                    <Setter Property="Text" Value="Disetujui" />
                                    <Setter Property="Foreground" Value="#047857" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                    <Setter Property="Text" Value="Ditolak" />
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="BoldCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="MutedCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Registrasi Tim" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Daftarkan tim peserta, lalu validasi (approve) pendaftarannya" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ FORM ============ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#EEF2FF">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="22" Height="22"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Nama Tim" Margin="0,0,0,18"
                             Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Nama Kapten" Margin="0,0,0,18"
                             Text="{Binding CaptainName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Kontak (No. HP)" Margin="0,0,0,18"
                             Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" />

                    <DatePicker Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                materialDesign:HintAssist.Hint="Tanggal Daftar" Margin="0,0,0,24"
                                SelectedDate="{Binding RegisteredAt, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Command="{Binding SaveCommand}" Height="44"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SaveButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelEditCommand}" Content="Batal Edit" Margin="0,10,0,0" Height="40"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ============ DAFTAR TIM ============ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,18,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Daftar Tim" Style="{StaticResource SectionTitleStyle}" />
                            <Border CornerRadius="10" Background="#EEF2FF" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Teams.Count}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}" />
                            <TextBox Width="160" Margin="6,0,12,0" materialDesign:HintAssist.Hint="Cari tim / kapten..."
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Height="36" Margin="0,0,6,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Command="{Binding ExportExcelCommand}" ToolTip="Ekspor ke Excel">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" Foreground="#107C41" VerticalAlignment="Center" />
                                    <TextBlock Text="Excel" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Height="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Command="{Binding ExportPdfCommand}" ToolTip="Ekspor ke PDF">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Foreground="#DC2626" VerticalAlignment="Center" />
                                    <TextBlock Text="PDF" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TeamsView}"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="Transparent" BorderThickness="0" RowHeight="56"
                              Margin="12,0,12,12"
                              materialDesign:DataGridAssist.CellPadding="12,8,8,8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Tim" Binding="{Binding Name}" Width="1.6*" MinWidth="110"
                                                ElementStyle="{StaticResource BoldCellStyle}" />
                            <DataGridTextColumn Header="Kapten" Binding="{Binding CaptainName}" Width="1.4*" MinWidth="100"
                                                ElementStyle="{StaticResource MutedCellStyle}" />
                            <DataGridTextColumn Header="Kontak" Binding="{Binding Contact}" Width="1.2*" MinWidth="95"
                                                ElementStyle="{StaticResource MutedCellStyle}" />
                            <DataGridTextColumn Header="Tgl Daftar" Binding="{Binding RegisteredAt, StringFormat={}{0:dd MMM yyyy}}" Width="1.1*" MinWidth="90"
                                                ElementStyle="{StaticResource MutedCellStyle}" />
                            <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="90"
                                                    CellTemplate="{StaticResource StatusChipTemplate}" />
                            <DataGridTemplateColumn Header="Aksi" Width="Auto" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Approve: disembunyikan bila sudah Approved -->
                                            <Button ToolTip="Setujui pendaftaran" Foreground="#059669"
                                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowIconButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20" />
                                            </Button>

                                            <!-- Reject: disembunyikan bila sudah Rejected -->
                                            <Button ToolTip="Tolak pendaftaran" Foreground="#D97706"
                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowIconButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="20" Height="20" />
                                            </Button>

                                            <Button Style="{StaticResource RowIconButtonStyle}" ToolTip="Edit" Foreground="{StaticResource AccentBrush}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" />
                                            </Button>

                                            <Button Style="{StaticResource RowIconButtonStyle}" ToolTip="Hapus" Foreground="#DC2626"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
