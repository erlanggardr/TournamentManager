<UserControl x:Class="TournamentManager.Views.StandingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="RankCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="TeamCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NumCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PointsCellStyle" TargetType="TextBlock" BasedOn="{StaticResource NumCellStyle}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Klasemen Turnamen Valorant" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Format standar VLR.gg · Urutan dihitung dari Match W-L, Win Rate (%), Map Differential (Δ), dan Poin VCT (1 Win = 1 Pt)"
                           Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Aksi & Filter -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Filter Babak -->
                <ComboBox Width="160" Margin="0,0,12,0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Filter Babak"
                          ItemsSource="{Binding AvailableRounds}"
                          SelectedItem="{Binding SelectedRound}" />

                <Button Style="{StaticResource HeaderActionButtonStyle}"
                        Command="{Binding ExportExcelCommand}" ToolTip="Ekspor ke Excel (.xlsx)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Foreground="#107C41" />
                        <TextBlock Text="Excel" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource HeaderActionButtonStyle}"
                        Command="{Binding ExportPdfCommand}" ToolTip="Ekspor ke PDF (.pdf)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" VerticalAlignment="Center" Foreground="#DC2626" />
                        <TextBlock Text="PDF" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource HeaderActionButtonStyle}"
                        Command="{Binding RefreshCommand}" ToolTip="Muat Ulang">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabel Klasemen -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Standings}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="Transparent" BorderThickness="0" RowHeight="52"
                          Margin="12,8,12,12"
                          materialDesign:DataGridAssist.CellPadding="12,8,8,8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,8,8,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pos" Binding="{Binding Rank}" Width="50"
                                            ElementStyle="{StaticResource RankCellStyle}" />
                        <DataGridTextColumn Header="Tim" Binding="{Binding TeamName}" Width="2*" MinWidth="130"
                                            ElementStyle="{StaticResource TeamCellStyle}" />
                        <DataGridTextColumn Header="M" Binding="{Binding MatchesPlayed}" Width="50"
                                            ElementStyle="{StaticResource NumCellStyle}" />
                        <DataGridTextColumn Header="Match W - L" Binding="{Binding MatchRecord}" Width="1.1*" MinWidth="90"
                                            ElementStyle="{StaticResource NumCellStyle}" />
                        <DataGridTextColumn Header="Win %" Binding="{Binding WinRate}" Width="0.9*" MinWidth="70"
                                            ElementStyle="{StaticResource NumCellStyle}" />
                        <DataGridTextColumn Header="Map W - L" Binding="{Binding MapRecord}" Width="1.1*" MinWidth="90"
                                            ElementStyle="{StaticResource NumCellStyle}" />
                        <DataGridTextColumn Header="Map Diff (Δ)" Binding="{Binding MapDiff, StringFormat={}{0:+0;-0;0}}" Width="1.1*" MinWidth="95"
                                            ElementStyle="{StaticResource NumCellStyle}" />
                        <DataGridTextColumn Header="Pts" Binding="{Binding Points}" Width="65"
                                            ElementStyle="{StaticResource PointsCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Standings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="FormatListNumbered" Width="54" Height="54" HorizontalAlignment="Center" Foreground="#CBD5E1" />
                    <TextBlock Text="Belum ada pertandingan yang selesai untuk dihitung klasemennya."
                               Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
