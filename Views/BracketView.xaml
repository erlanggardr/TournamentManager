<UserControl x:Class="TournamentManager.Views.BracketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="BoldCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bracket &amp; Penjadwalan Otomatis" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Buat jadwal pertandingan secara instan menggunakan sistem gugur atau grup dari tim yang disetujui"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Generator Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,20">
            <WrapPanel VerticalAlignment="Center">
                <!-- Pilihan Format -->
                <ComboBox Width="230" Margin="0,4,14,4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Format Turnamen"
                          ItemsSource="{Binding Formats}"
                          SelectedValuePath="Format"
                          SelectedValue="{Binding SelectedFormat}"
                          DisplayMemberPath="DisplayName" />

                <!-- Jumlah Grup (muncul untuk GroupStage) -->
                <TextBox Width="120" Margin="0,4,14,4"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Jumlah Grup"
                         IsEnabled="{Binding IsGroupStage}"
                         Text="{Binding NumberOfGroups, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Nama Babak / Prefix -->
                <TextBox Width="150" Margin="0,4,14,4"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Label Babak"
                         Text="{Binding RoundPrefix, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Tanggal Mulai -->
                <DatePicker Width="140" Margin="0,4,14,4"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="Tgl Mulai"
                            SelectedDate="{Binding FirstMatchDate, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Jarak Antar Pertandingan (menit) -->
                <TextBox Width="120" Margin="0,4,16,4"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Jeda (menit)"
                         Text="{Binding MinutesBetweenMatches, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Tombol Generate -->
                <Button Height="44" Margin="0,4,10,4"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        Command="{Binding GenerateBracketCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AutoFix" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Generate Jadwal" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Tombol Hapus Pending -->
                <Button Height="44" Margin="0,4,0,4"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        Foreground="#DC2626"
                        Command="{Binding ClearGeneratedMatchesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Reset Belum Mulai" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Preview Daftar Pertandingan yang Dibuat -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,18,24,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Daftar Pertandingan Terjadwal" Style="{StaticResource SectionTitleStyle}" />
                        <Border CornerRadius="10" Background="#EEF2FF" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GeneratedMatches.Count}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding GeneratedMatches}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="Transparent" BorderThickness="0" RowHeight="52"
                          Margin="12,0,12,12"
                          materialDesign:DataGridAssist.CellPadding="12,8,8,8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,8,8,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Babak" Binding="{Binding Round}" Width="1.5*" MinWidth="110"
                                            ElementStyle="{StaticResource BoldCellStyle}" />
                        <DataGridTextColumn Header="Grup" Binding="{Binding GroupName}" Width="0.8*" MinWidth="75"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                        <DataGridTextColumn Header="Tim A" Binding="{Binding TeamAName}" Width="2*" MinWidth="120"
                                            ElementStyle="{StaticResource BoldCellStyle}" />
                        <DataGridTextColumn Header="VS" Binding="{Binding ScoreText}" Width="1*" MinWidth="65"
                                            ElementStyle="{StaticResource BoldCellStyle}" />
                        <DataGridTextColumn Header="Tim B" Binding="{Binding TeamBName}" Width="2*" MinWidth="120"
                                            ElementStyle="{StaticResource BoldCellStyle}" />
                        <DataGridTextColumn Header="Jadwal" Binding="{Binding ScheduledAt, StringFormat={}{0:dd MMM yyyy · HH:mm}}" Width="1.5*" MinWidth="125"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplayName}" Width="1*" MinWidth="85"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GeneratedMatches.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="CalendarClock" Width="52" Height="52" HorizontalAlignment="Center" Foreground="#CBD5E1" />
                    <TextBlock Text="Belum ada jadwal pertandingan. Klik tombol 'Generate Jadwal' di atas."
                               Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
