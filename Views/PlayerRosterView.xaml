<UserControl x:Class="TournamentManager.Views.PlayerRosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Chip Peran Roster (Inti, Sub, Coach) -->
        <DataTemplate x:Key="RoleChipTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEF2FF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="Main">
                                <Setter Property="Background" Value="#E0E7FF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Sub">
                                <Setter Property="Background" Value="#FEF3C7" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Coach">
                                <Setter Property="Background" Value="#F3E8FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding RoleDisplayName}" />
                            <Setter Property="Foreground" Value="#4338CA" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="Main">
                                    <Setter Property="Foreground" Value="#3730A3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="Sub">
                                    <Setter Property="Foreground" Value="#B45309" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="Coach">
                                    <Setter Property="Foreground" Value="#7E22CE" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="BoldCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="MutedCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Roster Tim Valorant" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Format standar VCT: 7 anggota per tim (5 Pemain Inti, 1 Cadangan/Sub, 1 Coach)"
                           Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Pilihan Tim Aktif -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox Width="210"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Pilih Tim"
                          ItemsSource="{Binding Teams}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTeam}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form Tambah/Edit Roster -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                <StackPanel Margin="18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#EEF2FF">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="22" Height="22"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Pilihan Peran Esports -->
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Peran Roster (Inti / Sub / Coach)"
                              Margin="0,0,0,16"
                              ItemsSource="{Binding AvailableRoles}"
                              SelectedValuePath="Role"
                              SelectedValue="{Binding SelectedRole}"
                              DisplayMemberPath="DisplayName" />

                    <!-- In-Game Name (IGN) -->
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="In-Game Name (IGN / Nickname)" Margin="0,0,0,16"
                             Text="{Binding InGameName, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Nama Lengkap / Asli -->
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Nama Lengkap / Asli" Margin="0,0,0,24"
                             Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Command="{Binding SaveCommand}" Height="44"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SaveButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelEditCommand}" Content="Batal Edit" Margin="0,10,0,0" Height="40"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Daftar Roster Tim -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,18,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Susunan Roster" Style="{StaticResource SectionTitleStyle}" />
                            <Border CornerRadius="10" Background="#EEF2FF" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerCountText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Breakdown kuota per peran -->
                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10"
                                Background="#F1F5F9" Padding="12,4">
                            <TextBlock Text="{Binding RosterSummaryText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Players}"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="Transparent" BorderThickness="0" RowHeight="52"
                              Margin="12,0,12,12"
                              materialDesign:DataGridAssist.CellPadding="12,8,8,8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8,8,8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Peran" Width="Auto" MinWidth="110"
                                                    CellTemplate="{StaticResource RoleChipTemplate}" />
                            <DataGridTextColumn Header="In-Game Name (IGN)" Binding="{Binding InGameName}" Width="1.2*" MinWidth="130"
                                                ElementStyle="{StaticResource BoldCellStyle}" />
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Name}" Width="1.5*" MinWidth="130"
                                                ElementStyle="{StaticResource MutedCellStyle}" />
                            <DataGridTemplateColumn Header="Aksi" Width="Auto" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowIconButtonStyle}" ToolTip="Edit" Foreground="{StaticResource AccentBrush}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" />
                                            </Button>

                                            <Button Style="{StaticResource RowIconButtonStyle}" ToolTip="Hapus" Foreground="#DC2626"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Players.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="52" Height="52" HorizontalAlignment="Center" Foreground="#CBD5E1" />
                        <TextBlock Text="Belum ada anggota roster di tim ini. Tambahkan 5 Pemain Inti, 1 Sub, dan 1 Coach."
                                   Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
