<UserControl x:Class="TournamentManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="ScoreCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TeamCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LiveMatches.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Judul halaman -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ringkasan turnamen · diperbarui otomatis, terakhir " Style="{StaticResource PageSubtitleStyle}" />
                <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource PageSubtitleStyle}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <!-- Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Pendaftar -->
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}"
                    Background="{StaticResource GradientIndigoBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Pendaftar" Foreground="#E0E7FF" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding TotalTeams}" Foreground="White" FontSize="46" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="tim terdaftar" Foreground="#C7D2FE" FontSize="13" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="52" Height="52"
                            CornerRadius="26" Background="#33FFFFFF">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: On Progress -->
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}"
                    Background="{StaticResource GradientAmberBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pertandingan On Progress" Foreground="#FEF3C7" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding OngoingMatches}" Foreground="White" FontSize="46" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="sedang berlangsung" Foreground="#FDE68A" FontSize="13" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="52" Height="52"
                            CornerRadius="26" Background="#33FFFFFF">
                        <materialDesign:PackIcon Kind="ProgressClock" Width="28" Height="28" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Selesai -->
            <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}"
                    Background="{StaticResource GradientEmeraldBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pertandingan Selesai" Foreground="#D1FAE5" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding CompletedMatches}" Foreground="White" FontSize="46" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="telah selesai" Foreground="#A7F3D0" FontSize="13" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="52" Height="52"
                            CornerRadius="26" Background="#33FFFFFF">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="28" Height="28" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Daftar pertandingan sedang berjalan -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,20,24,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Indikator LIVE berkedip -->
                        <Ellipse Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="Pertandingan Sedang Berjalan" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OngoingMatches}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text=" pertandingan live" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LiveMatches}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="Transparent" BorderThickness="0" RowHeight="52"
                          Margin="12,0,12,12"
                          materialDesign:DataGridAssist.CellPadding="12,8,8,8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,8,8,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Babak" Binding="{Binding Round}" Width="1.2*" MinWidth="110"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                        <DataGridTextColumn Header="Tim A" Binding="{Binding TeamAName}" Width="2*" MinWidth="120"
                                            ElementStyle="{StaticResource TeamCellStyle}" />
                        <DataGridTextColumn Header="Skor" Binding="{Binding ScoreText}" Width="1.2*" MinWidth="75"
                                            ElementStyle="{StaticResource ScoreCellStyle}" />
                        <DataGridTextColumn Header="Tim B" Binding="{Binding TeamBName}" Width="2*" MinWidth="120"
                                            ElementStyle="{StaticResource TeamCellStyle}" />
                        <DataGridTextColumn Header="Mulai" Binding="{Binding StartedAt, StringFormat={}{0:HH:mm}}" Width="*" MinWidth="60"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                        <DataGridTextColumn Header="Berjalan" Binding="{Binding ElapsedText}" Width="*" MinWidth="70"
                                            ElementStyle="{StaticResource MutedCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" Style="{StaticResource EmptyStateStyle}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="48" Height="48" HorizontalAlignment="Center"
                                             Foreground="#CBD5E1" />
                    <TextBlock Text="Belum ada pertandingan yang sedang berjalan" Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
